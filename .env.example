# ─────────────────────────────────────────────────────────────
# Shopify Store Configuration
# Copy this file to ".env" and fill in your real credentials.
# The VITE_ prefix exposes these variables to the renderer process.
# ─────────────────────────────────────────────────────────────

# Full store URL, e.g. https://your-shop.myshopify.com
VITE_SHOPIFY_STORE_URL=

# Admin API access token (starts with shpat_); never commit the real value
VITE_SHOPIFY_ADMIN_API_TOKEN=

# Shopify location id used to scope inventory quantities (gid://shopify/Location/...).
# Auto-detected and cached on first run if left blank.
VITE_SHOPIFY_LOCATION_ID=

# Set to "true" to skip the live Shopify product fetch entirely and seed the
# local catalog with 10 hardcoded demo products instead — the app looks
# fully populated and is scannable for a trial/demo even with no internet
# or Shopify credentials at all. See docs/phase-11.md Task 3.
VITE_DEMO_MODE=false

# ─────────────────────────────────────────────────────────────
# Receipt Printer (Phase 5)
# ─────────────────────────────────────────────────────────────

# Set to "true" to skip hardware and log receipts to the console instead —
# lets a demo proceed without a physical printer.
VITE_MOCK_PRINTER=true

# ESC/POS printer address, e.g. tcp://192.168.0.50:9100
VITE_PRINTER_INTERFACE=tcp://192.168.0.100:9100

# Printed on the receipt header/cashier line.
VITE_STORE_NAME=RUBIS
VITE_CASHIER_NAME=Staff

# Fractional tax rate applied to the subtotal (0.08 = 8%). Defaults to 0.
VITE_TAX_RATE=0

# ─────────────────────────────────────────────────────────────
# Kenyan Integrations — M-Pesa / eTIMS (Phase 9)
# ─────────────────────────────────────────────────────────────

# Set to "true" to wire the M-Pesa/eTIMS mock providers into checkout.
# Only mock implementations exist as of Phase 9 — real Daraja/eTIMS
# middleware backends land in a later phase. Leave "false" (or unset)
# to run checkout exactly as before Phase 9.
VITE_USE_MOCK_INTEGRATIONS=false