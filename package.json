{
  "name": "rubis-pos-desktop",
  "version": "1.0.0",
  "description": "Custom Windows POS for RUBIS using Shopify backend",
  "type": "module",
  "main": "./out/main/index.js",
  "homepage": "https://github.com/Volcha-Enterprises/rubis-pos-desktop#readme",
  "bugs": {
    "url": "https://github.com/Volcha-Enterprises/rubis-pos-desktop/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Volcha-Enterprises/rubis-pos-desktop.git"
  },
  "license": "MIT",
  "author": "Paul Chesa",
  "scripts": {
    "check-node-version": "node scripts/check-node-version.cjs",
    "predev": "npm run check-node-version",
    "dev": "electron-vite dev",
    "prestart": "npm run check-node-version",
    "start": "electron-vite preview",
    "prebuild": "npm run check-node-version",
    "build": "npm run typecheck && electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "pretest": "npm run check-node-version",
    "test": "vitest run",
    "test:watch": "vitest",
    "predist": "npm run check-node-version",
    "dist": "npm run build && electron-builder --win",
    "predist:dir": "npm run check-node-version",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "preinstall": "node scripts/check-node-version.cjs",
    "postinstall": "electron-rebuild -f -w better-sqlite3 && electron-rebuild -f -w keytar",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "axios": "^1.19.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.3.9",
    "keytar": "^7.9.0",
    "node-thermal-printer": "^4.6.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.4.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=24 <25",
    "electron": ">=28"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
